:root {
  --bg: #0e0d12; /* Silvery Black */
  --text: #f3e8f0;
  --card: #1a1722;
  --lavender: #c084fc;
  --purple: #a855f7;
  --white: #ffffff;
}
[data-theme="light"] {
  --bg: #fff9fb;
  --text: #2d1b2e;
  --card: #f3e8f0;
}

* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Georgia', serif; }
body { background: var(--bg); color: var(--text); transition: 0.3s; line-height: 1.7; }
.hidden { display: none!important; }

button { padding: 10px 18px; border: none; border-radius: 8px; background: var(--lavender); color: var(--white); cursor: pointer; font-weight: bold; }
.btn-primary { background: var(--lavender); }
.btn-alt { background: var(--purple); }
.btn-share { background: #22c55e; }

header { position: sticky; top: 0; background: var(--card); padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--lavender); z-index: 10; }
.logo-header,.logo-landing { color: var(--purple); font-weight: bold; }
.logo-landing { font-size: 4rem; display: flex; align-items: center; gap: 2px; justify-content: center; }
.y-with-flower { position: relative; }
.flower { width: 22px; height: 22px; fill: var(--lavender); position: absolute; top: -8px; right: -12px; }
.tagline { opacity: 0.8; margin: 15px 0 30px; text-align: center; }

#landing { height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }
.container { max-width: 900px; margin: 0 auto; padding: 20px; }

.social-bar { display: flex; gap: 10px; justify-content: center; margin: 20px 0; flex-wrap: wrap; }
.social-bar a { padding: 8px 14px; background: var(--purple); color: var(--white); border-radius: 6px; text-decoration: none; font-size: 0.9rem; }

.ad-space { background: var(--card); padding: 15px; text-align: center; margin: 20px 0; border-radius: 10px; border: 1px dashed var(--lavender); min-height: 90px; }

.book-card { background: var(--card); padding: 15px; border-radius: 12px; margin-bottom: 15px; border-left: 4px solid var(--lavender); display: flex; gap: 15px; align-items: center; }
.book-cover { width: 80px; height: 120px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
.book-info { flex: 1; }
.book-header { display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
.book-cover-large { width: 150px; height: 220px; object-fit: cover; border-radius: 10px; border: 2px solid var(--lavender); }

.book-meta { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; }
.blurb { font-style: italic; opacity: 0.8; margin: 8px 0; }

.toc li { padding: 12px; background: var(--card); margin-bottom: 8px; border-radius: 8px; cursor: pointer; list-style: none; border-left: 3px solid var(--purple); }
.toc li:hover { background: var(--lavender); color: var(--white); }
.backBtn { margin-bottom: 15px; background: transparent; border: 1px solid var(--lavender); color: var(--lavender); }

.reader-box { background: var(--card); padding: 25px; border-radius: 12px; min-height: 60vh; font-size: 1.15rem; }
.reader-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px; }
.page-controls { display: flex; justify-content: space-between; margin-top: 20px; }

.comments { background: var(--card); padding: 20px; border-radius: 12px; margin-top: 25px; }
.comments input { width: 100%; padding: 10px; border: 1px solid var(--lavender); border-radius: 8px; background: var(--bg); color: var(--text); margin: 10px 0; }
.comment { background: var(--bg); padding: 10px; border-radius: 8px; margin-top: 8px; border-left: 3px solid var(--purple); }

.bar { background: var(--purple); height: 20px; border-radius: 5px; margin: 8px 0; position: relative; color: var(--white); padding-right: 10px; text-align: right; font-size: 0.8rem; }
